      "source": [
        "# Simple Travel Agent\n",
        "\n",
        "print(\"===== TRAVEL AGENT =====\")\n",
        "\n",
        "departure = input(\"Enter departure city: \")\n",
        "destination = input(\"Enter destination city: \")\n",
        "\n",
        "# Flights data\n",
        "flights = [\n",
        "    (\"Lahore\", \"Karachi\", 15000),\n",
        "    (\"Lahore\", \"Islamabad\", 8000),\n",
        "    (\"Karachi\", \"Lahore\", 15000),\n",
        "    (\"Lahore\", \"Dubai\", 50000)\n",
        "]\n",
        "\n",
        "found = False\n",
        "\n",
        "# Search for flight\n",
        "for flight in flights:\n",
        "    if flight[0].lower() == departure.lower() and flight[1].lower() == destination.lower():\n",
        "        print(\"\\nFlight Available!\")\n",
        "        print(\"From:\", flight[0])\n",
        "        print(\"To:\", flight[1])\n",
        "        print(\"Price: Rs.\", flight[2])\n",
        "\n",
        "        book = input(\"Do you want to book this flight? (yes/no): \")\n",
        "\n",
        "        if book.lower() == \"yes\":\n",
        "            print(\"Flight booked successfully!\")\n",
        "        else:\n",
        "            print(\"Booking cancelled.\")\n",
        "\n",
        "        found = True\n",
        "        break\n",
        "\n",
        "if found == False:\n",
        "    print(\"\\nNo flights available.\")"
      ]
